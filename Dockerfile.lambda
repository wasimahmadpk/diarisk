# Image for AWS Lambda. Same FastAPI app as the uvicorn image, but started
# through the Lambda runtime interface via Mangum (see src/lambda_handler.py).
FROM public.ecr.aws/lambda/python:3.11

# LightGBM needs OpenMP at runtime
RUN yum install -y libgomp && yum clean all && rm -rf /var/cache/yum

COPY requirements-api.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements-api.txt

# src/*.py import each other flat, so they go directly into the task root.
COPY src/ ${LAMBDA_TASK_ROOT}/
COPY models/ ${LAMBDA_TASK_ROOT}/models/

ENV DIARISK_MODEL_PATH=${LAMBDA_TASK_ROOT}/models/diarisk_lightgbm.joblib

CMD ["lambda_handler.handler"]
